{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iffat",
  "main": "./worker.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "iffat.auraplatform.org", "custom_domain": true }],
  "assets": { "directory": "./dist", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "404-page" }
}
